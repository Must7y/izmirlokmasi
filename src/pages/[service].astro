---
import Layout from '../layouts/Layout.astro';
import {services,whatsapp} from '../data/site';
export function getStaticPaths(){return services.map(service=>({params:{service:service.slug},props:{service}}))}
const {service}=Astro.props;
const titles = {
  'izmir-lokmasi': 'İzmir Lokması | Yerinde Lokma Dökümü',
  'saray-lokmasi': 'Saray Lokması | Yerinde Lokma İkramı',
  'hayir-lokmasi': 'Hayır Lokması Dökümü',
  'mevlit-lokmasi': 'Mevlit İçin Lokma Dökümü',
};
const planning = {
  'izmir-lokmasi': ['Halka lokma ikramı nasıl planlanır?', 'İkramın başlayacağı saati ve yaklaşık kişi sayısını paylaşın. Lokmanın nerede hazırlanacağını ve servis alanını önceden birlikte belirleyelim.'],
  'saray-lokmasi': ['Saray lokmasını ne zaman tercih edebilirsiniz?', 'Küçük, yuvarlak lokma ikramı istediğinizde saray lokmasını seçebilirsiniz. Teklif için etkinliğin tarihini, adresini ve tahmini misafir sayısını yazın.'],
  'hayir-lokmasi': ['Hayır lokması dağıtımı için neler gerekir?', 'Dağıtım yerini ve ikrama başlamak istediğiniz saati paylaşın. Yerinde hazırlık ve servis alanını konuma göre birlikte değerlendirelim.'],
  'mevlit-lokmasi': ['Mevlit sonrası ikram saati nasıl belirlenir?', 'Programın tahmini bitiş saatini, adresi ve misafir sayısını iletin. Hazırlık ve servisi programınıza göre planlayalım.'],
};
const [planningTitle, planningText] = planning[service.slug as keyof typeof planning];
const photo=service.slug==='saray-lokmasi'?'/images/saray-lokmasi-photo.webp':'/images/lokma-real-appetizing.webp';
const photoAlt=service.slug==='saray-lokmasi'?'Şerbetli yuvarlak saray lokması':'Şerbetli halka İzmir lokması';
---
<Layout title={(titles[service.slug as keyof typeof titles] ?? service.name) + ' · Hanifi Usta'} description={service.body}>
  <main id="main">
    <section class="service-hero section">
      <div><a class="text-link" href="/">← Ana sayfa</a><p class="eyebrow">{service.tag}</p><h1>{service.name}</h1><p>{service.body}</p><a class="button" href={whatsapp} target="_top">Bilgi ve fiyat alın ↗</a></div>
      <img src={photo} alt={photoAlt} width={1280} height={960} loading="eager" fetchpriority="high" decoding="async"/>
    </section>
    <section class="section service-info">
      <h2>{planningTitle}</h2>
      <p>{planningText}</p>
      <div class="related">
        <a href="/iletisim/">Lokma dökümü için iletişim ↗</a>
        {services.filter(item => item.slug !== service.slug).map(item =>
          <a href={'/' + item.slug + '/'}>{item.name} ↗</a>
        )}
      </div>
    </section>
  </main>
</Layout>
