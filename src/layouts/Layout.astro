---
import ArrowIcon from '../components/ArrowIcon.astro';
import '../styles/site.css';
import {whatsapp as defaultWhatsapp,whatsappForService} from '../data/site';
import SocialIcon from '../components/SocialIcon.astro';
import SiteMenu from '../components/SiteMenu.astro';
import ScrollDock from '../components/ScrollDock.astro';
import {contentRoutes,routeFor} from '../data/routes.mjs';
const {title='İstanbul Lokma Siparişi ve İzmir Lokması | Hanifi Usta',description='İstanbul ve çevre illerde lokma siparişi, hayır lokması döktürme ve mevlit ikramı için Hanifi Usta ile görüşün. İzmir veya saray lokması için teklif alın.',noindex=false,service}=Astro.props;
const whatsapp=service?whatsappForService(service.name):defaultWhatsapp;
const canonical=new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site);
const route = routeFor(canonical.pathname);
const homepage='https://izmirlokmasi.com';
const socialProfiles = [
  { name: 'Instagram', url: 'https://www.instagram.com/hanifiusta008/' },
  { name: 'YouTube', url: 'https://www.youtube.com/@hanifiklc8999' },
];
const facebookShareUrl = 'https://www.facebook.com/share/1E5EyhL6fV/';
const schema={
  '@context':'https://schema.org',
  '@graph':[
    {'@type':'Organization','@id':homepage+'/#organization',name:'İzmir Lokmacısı Hanifi Usta',url:homepage,logo:homepage+'/images/hanifi-logo-vector-integrated.webp',telephone:'+905306902501',email:'izmirlokmasii@gmail.com',areaServed:'İstanbul ve çevre iller',contactPoint:{'@type':'ContactPoint',telephone:'+905306902501',contactType:'customer service',availableLanguage:'Turkish'},sameAs:socialProfiles.map(profile => profile.url)},
    {'@type':'WebSite','@id':homepage+'/#website',url:homepage,name:'Hanifi Usta · Meşhur İzmir Lokmacısı',alternateName:'İzmir Lokmacısı Hanifi Usta',inLanguage:'tr-TR',publisher:{'@id':homepage+'/#organization'},hasPart:contentRoutes.filter(item=>item.indexable&&item.path!=='/').map(item=>({'@type':item.kind,'@id':homepage+item.path+'#webpage',url:homepage+item.path,name:item.label}))},
    ...(!noindex ? [{
      '@type':route?.kind || 'WebPage',
      '@id':canonical.href+'#webpage',url:canonical.href,name:title,description,
      inLanguage:'tr-TR',isPartOf:{'@id':homepage+'/#website'},
      ...(Astro.url.pathname!=='/'?{breadcrumb:{'@id':canonical.href+'#breadcrumb'}}:{}),
      ...(service?{mainEntity:{'@id':canonical.href+'#service'}}:route?.article?{mainEntity:{'@id':canonical.href+'#article'}}:{about:{'@id':homepage+'/#organization'}})
    }] : []),
    ...(service && !noindex ? [{
      '@type':'Service','@id':canonical.href+'#service',url:canonical.href,
      name:service.name,description:service.body,serviceType:service.name,areaServed:'İstanbul ve çevre iller',
      provider:{'@id':homepage+'/#organization'}
    }] : []),
    ...(route?.article && !noindex ? [{
      '@type':'Article','@id':canonical.href+'#article',headline:title.replace(/ \| Hanifi Usta$/,''),
      description,inLanguage:'tr-TR',url:canonical.href,
      mainEntityOfPage:{'@id':canonical.href+'#webpage'},
      author:{'@type':'Organization','@id':homepage+'/#organization',name:'Hanifi Usta',url:homepage+'/'},
      publisher:{'@id':homepage+'/#organization'},
      datePublished:'2026-11-27',dateModified:route.updated,
      image:[homepage+'/images/hero-mixed-lokma.webp'],
    }] : []),
    ...(!noindex && Astro.url.pathname!=='/' ? [{
      '@type':'BreadcrumbList','@id':canonical.href+'#breadcrumb',
      itemListElement:[
        {'@type':'ListItem',position:1,name:'Hanifi Usta',item:homepage+'/'},
        {'@type':'ListItem',position:2,name:route?.label||service?.name||'İletişim',item:canonical.href}
      ]
    }] : [])
  ]
};
---
<!doctype html>
<html lang="tr">
<head>
  <meta charset="UTF-8"/>
  <meta name="referrer" content="strict-origin-when-cross-origin"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <!-- Pages yanit basliklarini degistiremedigi icin istemci tarafinda CSP. frame-ancestors / HSTS icin HTTP basligi gerekir. -->
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self' https://www.googletagmanager.com; script-src-attr 'none'; style-src 'self'; style-src-attr 'none'; img-src 'self'; font-src 'self'; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; upgrade-insecure-requests"/>
  <title>{title}</title>
  <meta name="description" content={description}/>
  <link rel="canonical" href={canonical}/>
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon.png"/>
  <link rel="shortcut icon" href="/favicon.ico"/>
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png"/>
  <meta name="robots" content={noindex?"noindex,follow":"index,follow,max-image-preview:large"}/>
  <meta property="og:site_name" content="Hanifi Usta · Meşhur İzmir Lokmacısı"/>
  <meta property="og:title" content={title}/>
  <meta property="og:description" content={description}/>
  <meta property="og:url" content={canonical}/>
  <meta property="og:type" content="website"/>
  <meta property="og:locale" content="tr_TR"/>
  <meta property="og:image" content="https://izmirlokmasi.com/images/og-hanifi-usta.webp"/>
  <meta property="og:image:alt" content="İzmir lokması ve saray lokması ikramı – Hanifi Usta"/>
  <meta property="og:image:width" content="1200"/>
  <meta property="og:image:height" content="630"/>
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:title" content={title}/>
  <meta name="twitter:description" content={description}/>
  <meta name="twitter:image" content="https://izmirlokmasi.com/images/og-hanifi-usta.webp"/>
  <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/>
</head>
<body id="sayfa-basi">
<a class="skip" href="#main">İçeriğe geç</a>
<div class="top-note"><span>HAYIR • MEVLİT • ÖZEL GÜN LOKMASI</span><a href={whatsapp} target="_top" aria-label="Tarihinizi birlikte planlayalım: WhatsApp üzerinden bilgi alın">Tarihinizi birlikte planlayalım <ArrowIcon/></a></div>
<header class="header">
  <a class="brand" href="/">
    <img src="/images/hanifi-logo-vector-integrated.webp" width="72" height="72" alt=""/>
    <span>Hanifi Usta<small>MEŞHUR İZMİR LOKMACISI</small></span>
  </a>
  <SiteMenu/>
</header>
<slot/>
<footer class="footer footer-minimal"><div class="footer-identity"><a class="footer-word" href="/">Hanifi Usta</a><span>Lokmanın en güzel yanı, paylaşılması.</span></div><div class="footer-meta"><span>© {new Date().getFullYear()} Hanifi Usta</span><a href="/iletisim/">İletişim</a><a href="/gizlilik/">Gizlilik ve görsel bilgileri</a>
  {socialProfiles.map(profile => <a class="social-link" href={profile.url}><SocialIcon name={profile.name}/>{profile.name}</a>)}
  <a class="social-link" href={facebookShareUrl}><SocialIcon name="Facebook"/>Facebook</a></div><details class="analytics-preference"><summary>İstatistik tercihi</summary><p>Ziyaret edilen sayfaları ve iletişim bağlantısı tıklamalarını Google Analytics ile ölçmemize izin verebilirsiniz. İzin verene kadar Google Analytics yüklenmez. Tercihinizi buradan değiştirebilirsiniz. <a href="/gizlilik/#istatistik">Ayrıntılar</a></p><p id="analytics-status" role="status">Ziyaret istatistiği kapalı.</p><div class="analytics-actions"><button type="button" data-analytics-choice="granted" hidden>İzin ver</button><button type="button" data-analytics-choice="denied" hidden>Kapalı tut</button></div><noscript>JavaScript kapalı olduğundan istatistik toplanmaz.</noscript></details></footer>
<ScrollDock whatsapp={whatsapp}/>
<script is:inline src="/js/site.js" defer></script>
<script is:inline src="/js/analytics.js" defer></script>
</body></html>
