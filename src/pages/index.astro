---
import ArrowIcon from '../components/ArrowIcon.astro';
import { Image } from 'astro:assets';
import heroPhoto from '../../public/images/hero-mixed-lokma.webp';
import Layout from '../layouts/Layout.astro';
import Headline from '../components/Headline.astro';
import LokmaSlider from '../components/LokmaSlider.astro';
import {whatsapp,services} from '../data/site';
---
<Layout>
<main id="main">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="dot" aria-hidden="true"></span> HANİFİ USTA’DAN SICAK BİR GELENEK</p>
      <h1 id="hero-title">Yerinde<br/><em>İzmir lokması</em><br/>dökümü.</h1>
      <p class="hero-intro">İstanbul ve çevre illerde hayır, mevlit ve özel günler için halka İzmir lokması ve yuvarlak saray lokması döküyoruz. Lokma siparişi veya yerinde lokma döktürme için tarih, konum ve kişi sayısını paylaşarak teklif alabilirsiniz.</p>
      <div class="hero-actions"><a class="button" href={whatsapp} target="_top">Lokma siparişi için bilgi alın <ArrowIcon/></a><a class="text-link" href="#lokmalar">Lokmaları keşfedin <ArrowIcon direction="down"/></a></div>
      <div class="hero-trust" aria-label="Hizmet özeti"><span>Konuma göre planlama</span><span>Hayır & mevlit</span><span>Özel günler</span></div>
    </div>
    <div class="hero-art">
      <div class="hero-stage"><div class="hero-photo"><Image src={heroPhoto} widths={[480, 768, 1024, 1280]} sizes="(max-width: 800px) 92vw, 52vw" format="webp" alt="İzmir halka lokması ile yuvarlak saray lokmasının birlikte sunulduğu tepsi" width="1280" height="960" fetchpriority="high" loading="eager" decoding="async"/></div></div>
      <div class="hero-side-note"><span>İKRAMIN GÜZEL TARAFI</span><strong>Birlikte<br/>paylaşmak.</strong></div>
      <div class="hero-number"><span>01 / 02</span><span>İZMİR & SARAY LOKMASI</span></div>
    </div>
  </section>
  <div class="ribbon" aria-label="Lokma ikramı vesileleri"><span>HAYIR</span><i aria-hidden="true">◆</i><span>MEVLİT</span><i aria-hidden="true">◆</i><span>KUTLAMA</span><i aria-hidden="true">◆</i><span>PAYLAŞMAK</span></div>
  <section class="intro section" id="lokmalar" data-reveal>
    <div><p class="eyebrow">KÜÇÜK BİR LOKMA, BÜYÜK BİR ANLAM</p><h2>Mutluluk,<br/><em>paylaşınca</em><br/>çoğalır.</h2></div>
    <div class="intro-copy"><p>Bir hayrı paylaşmak, sevdiklerinizi anmak ya da güzel bir günü tatlandırmak için…</p><p>Hanifi Usta olarak İzmir lokması ve saray lokması ikramını tarih, adres ve kişi sayınıza göre birlikte planlıyoruz. Siz vesilenizi söyleyin, ayrıntıları konuşalım.</p><div class="related"><a href="/izmir-lokmasi/">İzmir lokması <ArrowIcon/></a><a href="/saray-lokmasi/">Saray lokması <ArrowIcon/></a></div></div>
  </section>
  <LokmaSlider/>
  <section class="section occasions" id="hizmet">
    <div class="occasion-top" data-reveal><Headline tagline="HER GÜZEL VESİLEDE" title="Lokma paylaşmak için bir neden yeter."/><p>Bir anma, bir dua, bir kutlama…<br/>İkramınızı birlikte planlayalım.</p></div>
    <div class="occasion-grid">
      {services.slice(2).map((s,i)=><a class="occasion" href={'/'+s.slug+'/'} data-reveal><span class="number">0{i+1} — İKRAM</span><span class="occasion-icon" aria-hidden="true"></span><h3>{s.name}</h3><p>{s.body}</p><span class="corner" aria-hidden="true"><ArrowIcon/></span></a>)}
      <a class="occasion" href="/iletisim/" data-reveal><span class="number">03 — İKRAM</span><span class="occasion-icon" aria-hidden="true"></span><h3>Özel günler</h3><p>Düğün, sünnet, açılış veya bir kutlama. Tarihinizi ve kişi sayısını paylaşın, organizasyonunuzu birlikte planlayalım.</p><span class="corner" aria-hidden="true"><ArrowIcon/></span></a>
    </div>
  </section>
  <section class="planning section" id="nasil">
    <div data-reveal><p class="eyebrow">PLANLAMASI DA KOLAY OLSUN</p><h2>Üç küçük<br/>bilgi, <em>tatlı<br/>bir başlangıç.</em></h2><p class="planning-lead">Uzun formlar yok. Detayları doğrudan konuşalım.</p><a class="button cream" href={whatsapp} target="_top">WhatsApp’tan konuşalım <ArrowIcon/></a><p><a class="planning-quote" href="/lokma-siparisi-rehberi/">Sipariş öncesi kontrol listesi <ArrowIcon/></a></p></div>
    <ol>{[['Tarih ve saat','Lokma ikramını hangi gün, saat kaçta düşündüğünüzü söyleyin.'],['Adres ve kişi sayısı','Organizasyonun yapılacağı konumu ve yaklaşık misafir sayısını yazın.'],['Detayları netleştirelim','Lokma türü, hazırlık, uygunluk ve güncel fiyatı birlikte konuşalım.']].map(([title,text],i)=><li data-reveal><span>0{i+1}</span><div><h3>{title}</h3><p>{text}</p>{i===2&&<a class="planning-quote" href="/iletisim/#teklif">Fiyat ve teklif kapsamı <ArrowIcon/></a>}</div><span class="step-arrow" aria-hidden="true"><ArrowIcon/></span></li>)}</ol>
  </section>
  <section class="section faq" data-reveal><Headline tagline="MERAK EDİLENLER" title="Aklınızda soru kalmasın."/><div>{[['Hangi bölgelerde hizmet veriyorsunuz?','İstanbul ve çevre illerde yerinde lokma döküyoruz. Organizasyonun tarihini ve konumunu paylaşın, uygunluğu birlikte kontrol edelim.'],['İzmir lokması ve saray lokması farklı mı?','İzmir lokması ortası delik halka, saray lokması küçük ve yuvarlak biçimindedir.'],['Lokma döktürme fiyatını nasıl öğrenebilirim?','Tarih, konum, kişi sayısı ve lokma türüne göre teklif verilir. Bu bilgileri WhatsApp’tan iletebilirsiniz.'],['Lokma siparişi nasıl verilir?','WhatsApp’tan tarih, adres, tahmini kişi sayısı ve lokma türünü yazın. Müsaitlik, fiyat ve servis ayrıntılarını birlikte netleştirdikten sonra siparişinizi teyit edin.'],['İstanbul’da hayır lokması döktürebilir miyim?','İstanbul ve çevre illerde yerinde hayır lokması döküyoruz. Dağıtım tarihini ve konumunu paylaşın; hazırlık alanını, servis saatini ve uygunluğu birlikte görüşelim.'],['Yerinde hazırlık yapılıyor mu?','Hazırlık ve servis koşulları organizasyon alanına göre değişebilir. Ayrıntıları sipariş öncesinde görüşüyoruz.']].map(([q,a])=><details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div></section>
  <section class="closing" data-reveal><img src="/images/hanifi-logo-vector-integrated.webp" alt="Hanifi Usta lokmacı amblemi" width="104" height="104" loading="lazy"/><p class="eyebrow">BİR TABAK DA SİZDEN OLSUN</p><h2>Güzel bir vesilede<br/><em>buluşalım.</em></h2><p>Paylaşmaya değer her güzel an için buradayız.</p><a class="button" href={whatsapp} target="_top">Hanifi Usta’ya yazın <ArrowIcon/></a></section>
</main>
</Layout>
