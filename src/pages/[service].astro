---
import ArrowIcon from '../components/ArrowIcon.astro';
import Layout from '../layouts/Layout.astro';
import {Image} from 'astro:assets';
import izmirPhoto from '../../public/images/lokma-real-appetizing.webp';
import sarayPhoto from '../../public/images/saray-lokmasi-photo.webp';
import {services,whatsapp,serviceDetails} from '../data/site';
export function getStaticPaths(){return services.map(service=>({params:{service:service.slug},props:{service}}))}
const {service}=Astro.props;
const details=serviceDetails[service.slug as keyof typeof serviceDetails];
const photo=service.slug==='saray-lokmasi'?sarayPhoto:izmirPhoto;
const photoAlt=service.slug==='saray-lokmasi'?'Şerbetli yuvarlak saray lokması':'Şerbetli halka İzmir lokması';
---
<Layout title={details.title + ' · Hanifi Usta'} description={details.description} service={service}>
  <main id="main">
    <section class="service-hero section">
      <div><a class="text-link" href="/"><ArrowIcon direction="left"/> Ana sayfa</a><p class="eyebrow">{service.tag}</p><h1>{details.heading}</h1><p>{service.body}</p><a class="button" href={whatsapp} target="_top">Bilgi ve fiyat alın <ArrowIcon/></a></div>
      <Image src={photo} widths={[480,768,1024,1280]} sizes="(max-width: 800px) 88vw, 42vw" format="webp" alt={photoAlt} width={1280} height={960} loading="eager" fetchpriority="high" decoding="async"/>
    </section>
    <section class="section service-info"><h2>{details.orderTitle}</h2><p>{details.orderText}</p><h2>{details.planningTitle}</h2><p>{details.planning}</p>
      {details.questions.map(([question,answer])=><div><h3>{question}</h3><p>{answer}</p></div>)}
      <p><a class="text-link" href="/iletisim/#teklif">Fiyata dahil olanları ve servis planını netleştirin <ArrowIcon/></a></p><div class="related"><a href="/iletisim/">Lokma dökümü için iletişim <ArrowIcon/></a>{services.filter(s=>s.slug!==service.slug).map(s=><a href={'/'+s.slug+'/'}>{s.name} <ArrowIcon/></a>)}</div>
    </section>
  </main>
</Layout>
