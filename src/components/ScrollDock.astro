---
import {whatsapp as defaultWhatsapp} from '../data/site';
const {whatsapp=defaultWhatsapp}=Astro.props;
---
<aside class="contact-dock" aria-label="Hızlı erişim">
  <a class="lokma-top" href="#sayfa-basi" aria-label="Sayfanın başına dön">
    <svg class="lokma-sculpture" viewBox="0 0 72 72" aria-hidden="true">
      <defs>
        <mask id="lokma-cutout"><path fill="white" fill-rule="evenodd" d="M35 7C50 6 61 14 66 28C71 43 64 58 50 64C35 71 18 66 9 55C0 44 4 25 14 16C21 10 27 8 35 7ZM38 24C33 24 29 29 29 35C29 41 33 45 38 44C44 43 47 37 46 32C45 27 42 24 38 24Z"/></mask>
        <filter id="lokma-silver"><feColorMatrix type="saturate" values="0"/></filter>
        <clipPath id="lokma-reveal"><rect data-scroll-progress x="0" y="72" width="72" height="0"/></clipPath>
      </defs>
      <g mask="url(#lokma-cutout)">
        <image href="/images/lokma-real-appetizing.webp" x="-98" y="-22" width="256" height="192" filter="url(#lokma-silver)"/>
        <image href="/images/lokma-real-appetizing.webp" x="-98" y="-22" width="256" height="192" clip-path="url(#lokma-reveal)"/>
      </g>
    </svg>
    <span class="dock-hint">Lokmaya dokun, başa dön</span>
  </a>
  <a class="floating-wa" href={whatsapp} target="_top" aria-label="Hanifi Usta’ya WhatsApp’tan yazın">
    <img src="/icons/whatsapp.svg" alt="" width="25" height="25"/>
    <span class="dock-hint">Hanifi Usta’ya yazın</span>
  </a>
</aside>
