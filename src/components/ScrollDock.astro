---
import {whatsapp as defaultWhatsapp} from '../data/site';
const {whatsapp=defaultWhatsapp}=Astro.props;
---
<aside class="contact-dock" aria-label="Hızlı erişim">
  <a class="lokma-top" href="#sayfa-basi" aria-label="Sayfanın başına dön">
    <svg class="lokma-sculpture" viewBox="0 0 72 72" aria-hidden="true">
      <defs>
        <mask id="lokma-cutout"><path fill="white" fill-rule="evenodd" d="M35 7C50 6 61 14 66 28C71 43 64 58 50 64C35 71 18 66 9 55C0 44 4 25 14 16C21 10 27 8 35 7ZM38 24C33 24 29 29 29 35C29 41 33 45 38 44C44 43 47 37 46 32C45 27 42 24 38 24Z"/></mask>
        <filter id="lokma-silver"><feColorMatrix type="saturate" values="0"/></filter>
        <radialGradient id="lokma-syrup"><stop stop-color="#fff8df" stop-opacity=".9"/><stop offset=".35" stop-color="#ffd68a" stop-opacity=".5"/><stop offset="1" stop-color="#ffd68a" stop-opacity="0"/></radialGradient>
        <clipPath id="lokma-reveal"><rect data-scroll-progress x="0" y="0" width="72" height="0"/></clipPath>
      </defs>
      <g mask="url(#lokma-cutout)">
        <image href="/images/lokma-real-appetizing.webp" x="-98" y="-22" width="256" height="192" filter="url(#lokma-silver)"/>
        <image href="/images/lokma-real-appetizing.webp" x="-98" y="-22" width="256" height="192" clip-path="url(#lokma-reveal)"/>
        <g clip-path="url(#lokma-reveal)"><ellipse class="lokma-glint" data-scroll-glint cx="36" cy="-1" rx="34" ry="5" fill="url(#lokma-syrup)"/></g>
      </g>
    </svg>
    <span class="dock-hint">Lokmaya dokun, başa dön</span>
  </a>
  <a class="floating-wa" href={whatsapp} target="_top" aria-label="Hanifi Usta’ya WhatsApp’tan yazın">
    <svg class="wa-seal" viewBox="0 0 64 64" fill="none" aria-hidden="true">
      <defs>
        <linearGradient id="wa-gilt" x1="7" y1="5" x2="56" y2="61" gradientUnits="userSpaceOnUse"><stop stop-color="#fff1c5"/><stop offset=".23" stop-color="#bd853b"/><stop offset=".47" stop-color="#f1cf86"/><stop offset=".74" stop-color="#98602b"/><stop offset="1" stop-color="#e3b768"/></linearGradient>
        <radialGradient id="wa-enamel" cx="0" cy="0" r="1" gradientTransform="translate(23 16) rotate(67) scale(48)" gradientUnits="userSpaceOnUse"><stop stop-color="#87494b"/><stop offset=".48" stop-color="#59262d"/><stop offset="1" stop-color="#2f151d"/></radialGradient>
        <linearGradient id="wa-reflection" x1="16" y1="10" x2="45" y2="52" gradientUnits="userSpaceOnUse"><stop stop-color="#fff8db" stop-opacity=".62"/><stop offset=".5" stop-color="#fff8db" stop-opacity="0"/></linearGradient>
      </defs>
      <path class="wa-foundry" d="M32 3C37 1 41 6 45 7C50 7 53 11 54 16C59 19 61 23 59 28C63 33 61 38 57 41C57 47 53 51 48 52C45 58 40 59 35 58C30 62 25 60 21 57C15 58 11 54 10 49C4 47 3 42 5 37C1 32 3 27 6 23C5 17 9 13 14 12C17 6 22 5 27 6C28 4 30 3 32 3Z" fill="url(#wa-gilt)"/>
      <circle cx="32" cy="32" r="24" fill="#713632"/>
      <circle class="wa-enamel" cx="32" cy="31" r="22.6" fill="url(#wa-enamel)"/>
      <path d="M14 28C16 15 29 9 41 15" stroke="url(#wa-reflection)" stroke-width="1.3" stroke-linecap="round"/>
      <path d="M23 51C35 57 49 47 51 37" stroke="#d8a45b" stroke-opacity=".38" stroke-width=".7" stroke-linecap="round"/>
    </svg>
    <span class="wa-light" aria-hidden="true"></span>
    <img class="wa-brand" src="/icons/whatsapp.svg" alt="" width="25" height="25"/>
    <span class="dock-hint">Hanifi Usta’ya yazın</span>
  </a>
</aside>
